"""
Ejercicio 1: Calcular el area de dos triangulos y mostrar la suma de sus areas.


ENTRADA
- base1: base del primer triangulo en centimetros.
- altura1: altura del primer triangulo en centimetros.
- base2: base del segundo triangulo en centimetros.
- altura2: altura del segundo triangulo en centimetros.

PROCESO
- Crear una funcion que reciba la base y la altura.
- Calcular el area con la formula base * altura / 2.
- Llamar la funcion para los dos triangulos.
- Sumar las areas obtenidas.

SALIDA
- Mostrar las dos areas y la suma total en cm cuadrados.
"""

def area_triangulo(base: float, altura: float) -> float:
    area = base * altura / 2
    return area

base1 = float(input("Ingrese la base del primer triangulo: "))
altura1 = float(input("Ingrese la altura del primer triangulo: "))

base2 = float(input("Ingrese la base del segundo triangulo: "))
altura2 = float(input("Ingrese la altura del segundo triangulo: "))

area1 = area_triangulo(base1, altura1)
area2 = area_triangulo(base2, altura2)

suma = area1 + area2

print("Area del primer triangulo:", area1, "cm2")
print("Area del segundo triangulo:", area2, "cm2")
print("Suma de las areas:", suma, "cm2")
